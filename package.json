{
  "name": "@znith/workspace",
  "private": true,
  "version": "0.3.1",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "pnpm --filter @znith/studio dev",
    "build": "pnpm --filter @znith/studio build",
    "start": "pnpm --filter @znith/studio start",
    "test": "vitest run",
    "typecheck": "pnpm --filter @znith/studio typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test",
    "version:check": "node scripts/check-version-sync.mjs",
    "prepare": "husky"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "eslint-config-prettier": "10.1.8",
    "husky": "^9.1.7",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
