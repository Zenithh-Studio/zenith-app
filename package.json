{
  "name": "@znith/studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.3",
  "scripts": {
    "dev": "node scripts/run-cli.mjs next dev",
    "build": "node scripts/run-cli.mjs payload build",
    "start": "node scripts/run-cli.mjs next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit --pretty false",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "pnpm format:check",
    "verify": "pnpm format:check && pnpm typecheck && pnpm test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "generate:importmap": "node scripts/run-cli.mjs payload generate:importmap",
    "generate:types": "node scripts/run-cli.mjs payload generate:types",
    "payload": "node scripts/run-cli.mjs payload",
    "prepare": "husky"
  },
  "dependencies": {
    "@payloadcms/figma": "1.0.0-beta.1",
    "@payloadcms/next": "4.0.0-beta.4",
    "@payloadcms/plugin-mcp": "4.0.0-beta.4",
    "@payloadcms/richtext-lexical": "4.0.0-beta.4",
    "@payloadcms/translations": "4.0.0-beta.4",
    "@payloadcms/ui": "4.0.0-beta.4",
    "@znith/be": "workspace:*",
    "@znith/contracts": "workspace:*",
    "@znith/fe": "workspace:*",
    "@znith/utils": "workspace:*",
    "graphql": "^16.8.1",
    "next": "16.4.2",
    "payload": "4.0.0-beta.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "^0.35.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "24.12.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "husky": "^9.1.7",
    "oxfmt": "^0.73.0",
    "postcss": "^8.5.0",
    "tailwindcss": "^4.0.0",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.1",
    "pnpm": ">=10 <11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
