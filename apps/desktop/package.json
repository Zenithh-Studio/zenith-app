{
  "name": "@znith/desktop",
  "version": "0.2.0",
  "private": true,
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n web,main,app \"pnpm dev:renderer\" \"pnpm dev:main\" \"pnpm dev:launch\"",
    "dev:renderer": "vite --host 127.0.0.1",
    "dev:main": "tsup electron/main.ts electron/preload.ts --format cjs --platform node --target node22 --out-dir dist-electron --watch --external electron --external better-sqlite3 --external drizzle-orm --external drizzle-orm/*",
    "dev:launch": "wait-on http://127.0.0.1:5173 dist-electron/main.cjs && cross-env ZNITH_DEV_SERVER=http://127.0.0.1:5173 electron .",
    "build": "vite build && tsup electron/main.ts electron/preload.ts --format cjs --platform node --target node22 --out-dir dist-electron --external electron --external better-sqlite3 --external drizzle-orm --external drizzle-orm/*",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "package:dir": "pnpm build && electron-builder --dir",
    "package:win": "pnpm build && electron-builder --win nsis",
    "package:linux": "pnpm build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "@znith/contracts": "workspace:*",
    "@znith/node-registry": "workspace:*",
    "@znith/workflow-engine": "workspace:*",
    "@znith/database": "workspace:*",
    "@znith/local-runner": "workspace:*",
    "@xyflow/react": "^12.9.3",
    "better-sqlite3": "^12.2.0",
    "drizzle-orm": "^0.44.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "wait-on": "^8.0.4"
  }
}
