# Keep the password URL-safe and use the same value in DATABASE_URL.
POSTGRES_DB=znith
POSTGRES_USER=znith
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql://znith:change-this-postgres-password@database:5432/znith

# Empty uses a secret generated once and kept in a Docker volume.
PAYLOAD_SECRET=

# Optional one-time token to promote the first app account to administrator.
# Keep this separate from the Payload Admin credentials and rotate after setup.
APP_ADMIN_SETUP_TOKEN=

# Set this to the public origin before building for a self-hosted domain.
SITE_URL=http://localhost:3001
APP_PORT=3001
POSTGRES_PORT=55432

# ChatGPT2API OpenAI-compatible API for image generation.
# Use http://host.docker.internal:3000/v1 for a service exposed on the host,
# or the Compose service URL (for example http://chatgpt2api:3000/v1) on a shared Docker network.
APP_CHATGPT2API_BASE_URL=http://host.docker.internal:3000/v1
APP_CHATGPT2API_API_KEY=

# Muse2API gateway for video generation. Compose builds and starts the gateway.
# The browser driver is enabled by default. Leave keys blank to generate distinct,
# persistent API/admin keys on first startup; only the API key is shared with the app.
MUSE2API_DRIVER=browser
MUSE2API_PORT=18610
MUSE2API_API_KEY=
MUSE2API_ADMIN_KEY=
# The app talks to the gateway over the private Compose network.
APP_MUSE2API_BASE_URL=http://muse2api:18610/v1
# Optional legacy override; normally leave blank so the app reads the generated key volume.
APP_MUSE2API_API_KEY=

# Optional video providers. Configure credentials only for the models you plan to use.
APP_GEMINI_API_KEY=
REPLICATE_API_TOKEN=
RUNWAYML_API_SECRET=
