# Keep the password URL-safe and use the same value in DATABASE_URL.
POSTGRES_DB=znith
POSTGRES_USER=znith
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql://znith:change-this-postgres-password@database:5432/znith

# Empty uses a secret generated once and kept in a Docker volume.
PAYLOAD_SECRET=

# Set this to the public origin before building for a self-hosted domain.
SITE_URL=http://localhost:3001
APP_PORT=3001
POSTGRES_PORT=55432

# ChatGPT2API OpenAI-compatible API for image generation.
# Use http://host.docker.internal:3000/v1 for a service exposed on the host,
# or the Compose service URL (for example http://chatgpt2api:3000/v1) on a shared Docker network.
APP_CHATGPT2API_BASE_URL=http://host.docker.internal:3000/v1
APP_CHATGPT2API_API_KEY=

# Muse2API gateway for video generation. Run the gateway separately and configure its real account/driver.
# Use http://host.docker.internal:18610/v1 for a service exposed on the host,
# or http://muse2api:18610/v1 when both containers share a Docker network.
APP_MUSE2API_BASE_URL=http://host.docker.internal:18610/v1
APP_MUSE2API_API_KEY=
